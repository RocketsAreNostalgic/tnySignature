{
  "name": "tny-signature",
  "description": "WordPress plugin providing a signature button in the TinyMCE editor",
  "author": "Benjamin Rush",
  "license": "MIT",
  "homepage": "https://github.com/RocketsAreNostalgic/tnySignature",
  "type": "module",
  "config": {
    "dist": "assets/dist",
    "src_public": "assets/src/public",
    "src_admin": "assets/src/admin",
    "dist_public": "assets/dist/public",
    "dist_admin": "assets/dist/admin"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RocketsAreNostalgic/tnySignature.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint \"assets/src/**/*.js\" vite.config.js \"tests/quality/**/*.mjs\"",
    "lint:css": "stylelint \"assets/src/**/*.{css,scss}\"",
    "format": "prettier --write \"assets/src/**/*.{js,css,scss}\" vite.config.js eslint.config.mjs \"tests/quality/**/*.mjs\" package.json pnpm-workspace.yaml",
    "format:check": "prettier --check \"assets/src/**/*.{js,css,scss}\" vite.config.js eslint.config.mjs \"tests/quality/**/*.mjs\" package.json pnpm-workspace.yaml",
    "check:generated": "pnpm build && git diff --exit-code -- assets/dist",
    "check": "pnpm lint:js && pnpm lint:css && pnpm format:check && pnpm check:generated && node --test tests/quality/*.test.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rocketsarenostalgic/quality-config": "github:RocketsAreNostalgic/ran-quality-config#751edd097e3902efb93992bf47401a1a4f4b1fa8",
    "@wordpress/browserslist-config": "6.54.0",
    "@wordpress/eslint-plugin": "25.7.0",
    "@wordpress/prettier-config": "4.51.0",
    "@wordpress/stylelint-config": "24.0.0",
    "browserslist": "4.29.0",
    "eslint": "9.39.5",
    "glob": "13.0.6",
    "prettier": "3.9.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "1.104.1",
    "stylelint": "16.26.1",
    "stylelint-scss": "6.14.0",
    "typescript": "6.0.3",
    "vite": "6.4.3"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=11 <12"
  },
  "volta": {
    "node": "24.11.0"
  },
  "packageManager": "pnpm@11.13.1"
}
